survey_data <- readRDS("../Data/encuesta.rds")
library(tidyverse)
dplyr::glimpse(survey_data)
options(survey.lonely.psu = "adjust")
library(survey)
library(srvyr)
survey_design <- survey_data %>%
as_survey_design(
strata = Stratum,
ids = PSU,
weights = wk,
nest = TRUE
)
#| label: tbl-total-ingreso
#| tbl-cap: "Estimación del total de ingresos de los hogares con intervalo de confianza al 95%"
#| echo: false
survey_design %>%
summarise(total = survey_total(Income, vartype = c("se", "ci"), deff = TRUE)) %>%
tabla_fmt()
#| label: tbl-total-gasto
#| tbl-cap: "Estimación del total de gastos de los hogares con intervalo de confianza al 90%"
#| echo: false
survey_design %>%
summarise(total = survey_total(Expenditure,
vartype = "ci", level = 0.9,
deff = TRUE)) %>%
tabla_fmt()
#| label: tbl-total-ingreso-sexo
#| tbl-cap: "Total de ingresos de los hogares desagregado por sexo"
#| echo: false
survey_design %>%
group_by(Sex) %>%
cascade(total = survey_total(Income,
vartype = c("se", "ci"),
level = 0.95),
.fill = "Total income") %>%
tabla_fmt()
#| label: tbl-media-ingreso
#| tbl-cap: "Estimación de la media de ingresos de los hogares"
#| echo: false
survey_design %>%
summarise(mean = survey_mean(Income,
vartype = c("se", "ci"),
level = 0.95,
deff = TRUE)) %>%
tabla_fmt()
#| label: tbl-media-gasto
#| tbl-cap: "Estimación de la media de gastos de los hogares"
#| echo: false
survey_design %>%
summarise(mean = survey_mean(Expenditure,
vartype = c("se", "ci"),
level = 0.95,
deff = TRUE)) %>%
tabla_fmt()
#| label: tbl-media-gasto-zona
#| tbl-cap: "Media de gastos de los hogares desagregada por zona"
#| echo: false
survey_design %>%
group_by(Zone) %>%
cascade(mean = survey_mean(Expenditure,
level = 0.95,
vartype = c("se", "ci")),
.fill = "Mean expenditure") %>%
tabla_fmt()
survey_design %>%
group_by(Zone, Region) %>%
cascade(mean = survey_mean(Expenditure,
level = 0.95,
vartype = c("se", "ci")),
.fill = "Mean expenditure")
survey_design %>%
group_by(Zone, Region) %>%
cascade(mean = survey_mean(Expenditure,
level = 0.95,
vartype = c("se", "ci")),
.fill = "Mean expenditure")
#| label: tbl-media-gasto-zona-reg
#| tbl-cap: "Media de gastos de los hogares desagregada por zona y sexo"
#| echo: false
survey_design %>%
group_by(Zone, Region) %>%
cascade(mean = survey_mean(Expenditure,
level = 0.95,
vartype = c("se", "ci")),
.fill = "Mean expenditure") %>%
tabla_fmt()
