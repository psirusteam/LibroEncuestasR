design = survey_design_heads,
level = 0.95)
oe = survey_data %>%
filter(PersonID == 01)
View(survey_data)
oe = survey_data %>%
filter(PersonID == "idPer01")
survey_design_heads  <- survey_design %>%
filter(PersonID == "idPer01")
ttest_sex <- svyttest(Income ~ Sex,
design = survey_design_heads,
level = 0.95)
View(oe)
survey_design_heads  <- survey_design %>%
filter(PersonID == "idPer01")
ttest_sex <- svyttest(Income ~ Sex,
design = survey_design_heads,
level = 0.95)
ttest_sex
#| label: tbl-ttest-sexo
#| tbl-cap: "Prueba de diferencia de ingresos medios por sexo (población total)"
#| echo: false
df_res <- tibble(
statistic = ttest_sex$statistic,
p_value = ttest_sex$p.value,
gl = ttest_sex$parameter,
ci_lower = ttest_sex$conf.int[1],
ci_upper = ttest_sex$conf.int[2],
estimated_difference = ttest_sex$estimate
)
df_res %>%
tabla_fmt()
table(survey_data$sex)
table(survey_data$Sex)
