)) %>%
tabla_fmt()
#| label: tbl-prop-sexo-urbano
#| tbl-cap: "Proporción de hombres y mujeres en zona urbana"
#| echo: false
urban_subset %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-zona-hombre
#| tbl-cap: "Distribución por zona en la subpoblación masculina"
#| echo: false
male_subset %>%
group_by(Zone) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-zona-pobreza-hombre
#| tbl-cap: "Proporción de hombres por zona y condición de pobreza"
#| echo: false
male_subset %>%
group_by(Zone, Poverty) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-edad-rango-empleo-mujer
#| tbl-cap: "Proporción de mujeres por rango de edad y estado de ocupación"
#| echo: false
female_subset %>%
filter(!is.na(Employment)) %>%
mutate(age_range = case_when(
Age >= 18 & Age <= 35 ~ "18 - 35",
TRUE ~ "Other"
)) %>%
group_by(age_range, Employment) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
sex_poverty_contrast <- svyby(
formula = ~poor,
by = ~Sex,
design = survey_design,
FUN = svymean,
na.rm = TRUE,
covmat = TRUE,
vartype = c("se", "ci")
)
#| label: tbl-svyby-pobreza-sexo2
#| tbl-cap: "Proporción en condición de pobreza por sexo"
#| echo: false
sex_poverty_contrast %>%
tabla_fmt()
sex_poverty_estimate <- setNames(
as.numeric(sex_poverty_contrast[["poor"]]),
sex_poverty_contrast[["Sex"]]
)
sex_poverty_estimate["Female"] - sex_poverty_estimate["Male"]
sex_poverty_vcov <- vcov(sex_poverty_contrast)
#| label: tbl-vcov-sex-pobreza
#| tbl-cap: "Matriz de varianzas y covarianzas de la proporción de pobreza por sexo"
#| echo: false
sex_poverty_vcov %>%
data.frame() %>%
tabla_fmt(digits = 10)
sqrt(
sex_poverty_vcov["Female", "Female"] +
sex_poverty_vcov["Male", "Male"] -
2 * sex_poverty_vcov["Female", "Male"]
)
svycontrast(
stat = sex_poverty_contrast,
contrasts = list(sex_difference = c(1, -1))
) %>%
data.frame()
region_unemployment_contrast <- svyby(
formula = ~ unemployed,
by = ~ Region,
design = survey_design %>%
filter(!is.na(unemployed)),
FUN = svymean,
na.rm = TRUE,
covmat = TRUE,
vartype = c("se", "ci")
)
#| label: tbl-svyby-desempleo-region
#| tbl-cap: "Proporción en condición de desempleo por región"
#| echo: false
region_unemployment_contrast %>%
tabla_fmt()
region_unemployment_vcov <- vcov(region_unemployment_contrast)
#| label: tbl-vcov-desempleo-region
#| tbl-cap: "Matriz de varianzas y covarianzas de la proporción de desempleo por región"
#| echo: false
region_unemployment_vcov %>%
data.frame() %>%
tabla_fmt(digits = 7)
# Norte - Centro
sqrt(
region_unemployment_vcov["Norte", "Norte"] +
region_unemployment_vcov["Centro", "Centro"] -
2 * region_unemployment_vcov["Norte", "Centro"]
)
# Sur - Centro
sqrt(
region_unemployment_vcov["Sur", "Sur"] +
region_unemployment_vcov["Centro", "Centro"] -
2 * region_unemployment_vcov["Sur", "Centro"]
)
# Occidente - Oriente
sqrt(
region_unemployment_vcov["Occidente", "Occidente"] +
region_unemployment_vcov["Oriente", "Oriente"] -
2 * region_unemployment_vcov["Occidente", "Oriente"]
)
svycontrast(
stat = region_unemployment_contrast,
contrasts = list(
north_center = c(1, 0, -1, 0, 0),
south_center = c(0, 1, -1, 0, 0),
west_east    = c(0, 0, 0, 1, -1)
)) %>%
data.frame()
lf_design <- survey_design %>%
filter(
!is.na(Employment),
Employment %in% c("Employed", "Unemployed")
)
lf_design %>%
group_by(Employment)
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design %>%
group_by(Employment) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design %>%
filter(Employment = "Employed") %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design %>%
filter(Employment == "Employed") %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design <- survey_design %>%
filter(
!is.na(Employment),
Employment %in% c("Employed", "Unemployed")
)
lf_design %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design <- survey_design %>%
filter(
!is.na(Employment),
Employment %in% c("Employed", "Unemployed")
)  %>%
mutate(
unemployed = Employment == "Unemployed"
)
lf_design %>%
summarise(proportion = survey_prop(vartype = c("se", "ci")))
lf_design <- survey_design %>%
filter(
!is.na(Employment),
Employment %in% c("Employed", "Unemployed")
)  %>%
mutate(
unemployed = Employment == "Unemployed"
)
lf_design %>%
group_by(Sex) %>%
summarise(
proportion = survey_mean(
unemployed,
proportion = TRUE,
vartype = c("se", "ci"),
level = 0.95,
na.rm = TRUE
)
)
render_html()
