options(scipen = 999, digits = 3)
source("../_tabla_helper.R")
library(tidyverse)
library(survey)
library(srvyr)
survey_data <- readRDS("../Data/encuesta.rds")
options(survey.lonely.psu = "adjust")
survey_design <- survey_data %>%
as_survey_design(
strata = Stratum,
ids = PSU,
weights = wk,
nest = TRUE
)
survey_design <- survey_design %>%
mutate(
poor = ifelse(Poverty != "NotPoor", 1, 0),
unemployed = ifelse(Employment == "Unemployed", 1, 0),
age_18 = case_when(
Age < 18 ~ "< 18 years",
TRUE ~ ">= 18 years"
)
)
urban_subset <- survey_design %>%
filter(Zone == "Urban")
rural_subset <- survey_design %>%
filter(Zone == "Rural")
female_subset <- survey_design %>%
filter(Sex == "Female")
male_subset <- survey_design %>%
filter(Sex == "Male")
#| label: tbl-tamano-zona
#| tbl-cap: "Tamaño poblacional estimado por zona geográfica"
#| echo: false
survey_design %>%
group_by(Zone) %>%
summarise(
n = unweighted(n()),
size = survey_total(vartype = c("se", "ci"))
) %>%
tabla_fmt()
#| label: tbl-tamano-pobreza
#| tbl-cap: "Tamaño poblacional estimado por condición de pobreza"
#| echo: false
survey_design %>%
group_by(Poverty) %>%
summarise(size = survey_total(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-tamano-empleo
#| tbl-cap: "Tamaño poblacional estimado por estado de ocupación"
#| echo: false
survey_design %>%
filter(!is.na(Employment)) %>%
group_by(Employment) %>%
summarise(size = survey_total(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-tamano-empleo-pobreza
#| tbl-cap: "Tamaño poblacional estimado por estado de ocupación y condición de pobreza"
#| echo: false
survey_design %>%
filter(!is.na(Employment)) %>%
group_by(Employment, Poverty) %>%
cascade(
size = survey_total(vartype = c("se", "ci")),
.fill = "Total"
) %>%
tabla_fmt()
#| label: tbl-prop-zona
#| tbl-cap: "Proporción de personas por zona geográfica"
#| echo: false
survey_design %>%
group_by(Zone) %>%
summarise(proportion = survey_mean(
vartype = c("se", "ci"),
proportion = TRUE
)) %>%
tabla_fmt()
#| label: tbl-prop-sexo-urbano
#| tbl-cap: "Proporción de hombres y mujeres en zona urbana"
#| echo: false
urban_subset %>%
group_by(Sex) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-zona-hombre
#| tbl-cap: "Distribución por zona en la subpoblación masculina"
#| echo: false
male_subset %>%
group_by(Zone) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-zona-pobreza-hombre
#| tbl-cap: "Proporción de hombres por zona y condición de pobreza"
#| echo: false
male_subset %>%
group_by(Zone, Poverty) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
#| label: tbl-prop-edad-rango-empleo-mujer
#| tbl-cap: "Proporción de mujeres por rango de edad y estado de ocupación"
#| echo: false
female_subset %>%
filter(!is.na(Employment)) %>%
mutate(age_range = case_when(
Age >= 18 & Age <= 35 ~ "18 - 35",
TRUE ~ "Other"
)) %>%
group_by(age_range, Employment) %>%
summarise(proportion = survey_prop(vartype = c("se", "ci"))) %>%
tabla_fmt()
sex_poverty_contrast <- svyby(
formula = ~poor,
by = ~Sex,
design = survey_design,
FUN = svymean,
na.rm = TRUE,
covmat = TRUE,
vartype = c("se", "ci")
)
sex_poverty_contrast
#| label: tbl-svyby-pobreza-sexo2
#| tbl-cap: "Proporción en condición de pobreza por sexo"
#| echo: false
sex_poverty_contrast %>%
tabla_fmt()
svycontrast(
stat = sex_poverty_contrast,
contrasts = list(sex_difference = c(1, -1))
) %>%
data.frame()
