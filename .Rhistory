Sys.unsetenv("QUARTO_PROFILE")
} else {
Sys.setenv(QUARTO_PROFILE = previous_profile)
}
}, add = TRUE)
Sys.unsetenv("QUARTO_PROFILE")
run_quarto(c("render", ".", "--to", "html"))
message("HTML generado: docs/index.html")
}
